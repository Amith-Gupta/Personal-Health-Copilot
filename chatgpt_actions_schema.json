{
  "openapi": "3.1.0",
  "info": {
    "title": "Personal Health Copilot API",
    "description": "Real-time API allowing ChatGPT to query family clinical records, active prescriptions, lab reports, and drug safety.",
    "version": "2.0.0"
  },
  "servers": [
    {
      "url": "https://witty-crabs-win.loca.lt"
    }
  ],
  "paths": {
    "/api/v1/chatgpt/patients": {
      "get": {
        "tags": [
          "ChatGPT Connector"
        ],
        "summary": "List all family patients",
        "description": "Retrieves all registered family patients with basic demographics and document counts.",
        "operationId": "listPatients",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object",
                    "properties": {
                      "item": {
                        "type": "string"
                      }
                    }
                  },
                  "type": "array",
                  "title": "Response Listpatients"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/chatgpt/patients/{patient_name_or_id}/summary": {
      "get": {
        "tags": [
          "ChatGPT Connector"
        ],
        "summary": "Get patient health summary",
        "description": "Retrieves an executive medical summary for a patient including diagnosed conditions, medications preview, and doctor visits.",
        "operationId": "getPatientSummary",
        "parameters": [
          {
            "name": "patient_name_or_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Patient Name Or Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Getpatientsummary",
                  "properties": {
                    "result": {
                      "type": "string",
                      "description": "Clinical data payload"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/chatgpt/patients/{patient_name_or_id}/medications": {
      "get": {
        "tags": [
          "ChatGPT Connector"
        ],
        "summary": "Get prescribed medications",
        "description": "Retrieves all active prescribed medications, dosages, frequencies, food timings, and prescribing doctors for a patient.",
        "operationId": "getPrescribedMedications",
        "parameters": [
          {
            "name": "patient_name_or_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Patient Name Or Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true,
                    "properties": {
                      "item": {
                        "type": "string"
                      }
                    }
                  },
                  "title": "Response Getprescribedmedications"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/chatgpt/patients/{patient_name_or_id}/lab-reports": {
      "get": {
        "tags": [
          "ChatGPT Connector"
        ],
        "summary": "Get laboratory test reports",
        "description": "Retrieves laboratory test observations with observed values, reference bounds, and clinical abnormal flags (HIGH, LOW, NORMAL).",
        "operationId": "getLabReports",
        "parameters": [
          {
            "name": "patient_name_or_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Patient Name Or Id"
            }
          },
          {
            "name": "test_filter",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter test name (e.g. 'glucose', 'tsh')",
              "title": "Test Filter"
            },
            "description": "Filter test name (e.g. 'glucose', 'tsh')"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true,
                    "properties": {
                      "item": {
                        "type": "string"
                      }
                    }
                  },
                  "title": "Response Getlabreports"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/chatgpt/drug-safety": {
      "post": {
        "tags": [
          "ChatGPT Connector"
        ],
        "summary": "Check drug-drug interactions and safety",
        "description": "Analyzes a list of medications for drug-drug interactions, duplicate therapeutic classes, and food/alcohol precautions.",
        "operationId": "checkDrugSafety",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DrugSafetyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Checkdrugsafety",
                  "properties": {
                    "result": {
                      "type": "string",
                      "description": "Clinical data payload"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/chatgpt/ask": {
      "post": {
        "tags": [
          "ChatGPT Connector"
        ],
        "summary": "Ask medical question grounded in records",
        "description": "Answers patient clinical questions grounded strictly in their health records with emergency crisis screening.",
        "operationId": "askHealthCopilot",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CopilotAskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Askhealthcopilot",
                  "properties": {
                    "result": {
                      "type": "string",
                      "description": "Clinical data payload"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/chatgpt/doctors": {
      "get": {
        "tags": [
          "ChatGPT Connector"
        ],
        "summary": "Find specialist doctors and hospitals",
        "description": "Finds top verified medical specialists and hospitals based on clinical diagnosis and city location.",
        "operationId": "findSpecialistDoctors",
        "parameters": [
          {
            "name": "specialty_or_condition",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Condition or specialty (e.g. 'Diabetes', 'Cardiology')",
              "title": "Specialty Or Condition"
            },
            "description": "Condition or specialty (e.g. 'Diabetes', 'Cardiology')"
          },
          {
            "name": "city",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "City name (e.g. 'Hyderabad', 'Tirupati', 'Bengaluru')",
              "default": "Hyderabad",
              "title": "City"
            },
            "description": "City name (e.g. 'Hyderabad', 'Tirupati', 'Bengaluru')"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true,
                    "properties": {
                      "item": {
                        "type": "string"
                      }
                    }
                  },
                  "title": "Response Findspecialistdoctors"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ABHALinkRequest": {
        "properties": {
          "abha_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Abha Number",
            "examples": [
              "91-1234-5678-9012"
            ]
          },
          "abha_address": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Abha Address",
            "examples": [
              "lakshmi.devi@abdm"
            ]
          }
        },
        "type": "object",
        "title": "ABHALinkRequest"
      },
      "Body_transcribe_voice_api_v1_voice_transcribe_post": {
        "properties": {
          "audio": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "Audio"
          },
          "language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Language"
          }
        },
        "type": "object",
        "required": [
          "audio"
        ],
        "title": "Body_transcribe_voice_api_v1_voice_transcribe_post"
      },
      "Body_upload_api_v1_health_records_upload_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "profile_id": {
            "type": "string",
            "title": "Profile Id"
          }
        },
        "type": "object",
        "required": [
          "file",
          "profile_id"
        ],
        "title": "Body_upload_api_v1_health_records_upload_post"
      },
      "Citation": {
        "properties": {
          "record_id": {
            "type": "string",
            "title": "Record Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "record_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Record Date"
          }
        },
        "type": "object",
        "required": [
          "record_id",
          "title"
        ],
        "title": "Citation"
      },
      "ConversationTurn": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "ConversationTurn"
      },
      "CopilotAskRequest": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query",
            "description": "The clinical question (e.g. 'What medications is Surya taking?')"
          },
          "patient_name_or_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Patient Name Or Id",
            "description": "Patient name or ID (e.g. 'Surya', 'Lakshmi Devi')"
          },
          "language": {
            "type": "string",
            "title": "Language",
            "description": "Language code ('en', 'hi', or 'te')",
            "default": "en"
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "CopilotAskRequest"
      },
      "CopilotQueryRequest": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Query"
          },
          "language": {
            "type": "string",
            "enum": [
              "en",
              "hi",
              "te"
            ],
            "title": "Language",
            "default": "en"
          },
          "profile_id": {
            "type": "string",
            "title": "Profile Id"
          },
          "lat": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lat"
          },
          "lon": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lon"
          },
          "city": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "City"
          },
          "history": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ConversationTurn"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "History"
          }
        },
        "type": "object",
        "required": [
          "query",
          "profile_id"
        ],
        "title": "CopilotQueryRequest"
      },
      "CopilotQueryResponse": {
        "properties": {
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "language": {
            "type": "string",
            "enum": [
              "en",
              "hi",
              "te"
            ],
            "title": "Language"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "type": "array",
            "title": "Citations"
          },
          "disclaimer": {
            "type": "string",
            "title": "Disclaimer"
          },
          "safety": {
            "type": "string",
            "enum": [
              "ok",
              "crisis"
            ],
            "title": "Safety",
            "default": "ok"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "doctors": {
            "items": {
              "$ref": "#/components/schemas/DoctorRecommendation"
            },
            "type": "array",
            "title": "Doctors"
          },
          "suggested_questions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Suggested Questions"
          },
          "format_hint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Format Hint",
            "default": "adaptive"
          }
        },
        "type": "object",
        "required": [
          "answer",
          "language",
          "disclaimer",
          "model"
        ],
        "title": "CopilotQueryResponse"
      },
      "DoctorRecommendation": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "specialty": {
            "type": "string",
            "title": "Specialty"
          },
          "hospital_name": {
            "type": "string",
            "title": "Hospital Name"
          },
          "address": {
            "type": "string",
            "title": "Address"
          },
          "city": {
            "type": "string",
            "title": "City"
          },
          "distance_km": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Distance Km"
          },
          "rating": {
            "type": "number",
            "title": "Rating",
            "default": 4.8
          },
          "maps_url": {
            "type": "string",
            "title": "Maps Url"
          },
          "phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "timings": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timings",
            "default": "Mon - Sat (10:00 AM - 5:00 PM)"
          }
        },
        "type": "object",
        "required": [
          "name",
          "specialty",
          "hospital_name",
          "address",
          "city",
          "maps_url",
          "reason"
        ],
        "title": "DoctorRecommendation"
      },
      "DoctorSearchRequest": {
        "properties": {
          "profile_id": {
            "type": "string",
            "title": "Profile Id"
          },
          "query": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Query"
          },
          "specialty": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Specialty"
          },
          "city": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "City",
            "default": "Hyderabad"
          },
          "lat": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lat"
          },
          "lon": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lon"
          },
          "language": {
            "type": "string",
            "enum": [
              "en",
              "hi",
              "te"
            ],
            "title": "Language",
            "default": "en"
          }
        },
        "type": "object",
        "required": [
          "profile_id"
        ],
        "title": "DoctorSearchRequest"
      },
      "DrugSafetyRequest": {
        "properties": {
          "medications": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Medications",
            "description": "List of medication names to check (e.g. ['Telmisartan', 'Ibuprofen'])"
          }
        },
        "type": "object",
        "required": [
          "medications"
        ],
        "title": "DrugSafetyRequest"
      },

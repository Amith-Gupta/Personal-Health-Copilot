            "title": "Patient Name"
          },
          "patient_age": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Patient Age"
          },
          "patient_sex": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Patient Sex"
          },
          "doctor_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Doctor Name"
          },
          "facility_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Facility Name"
          },
          "diagnoses": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Diagnoses"
          },
          "medications": {
            "items": {
              "$ref": "#/components/schemas/MedicationItem"
            },
            "type": "array",
            "title": "Medications"
          },
          "lab_observations": {
            "items": {
              "$ref": "#/components/schemas/LabObservationItem"
            },
            "type": "array",
            "title": "Lab Observations"
          },
          "summary": {
